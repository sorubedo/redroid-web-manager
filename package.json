{
  "name": "redroid-web-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "pnpm --filter redroid-web-manager-web dev",
    "build": "tsc && pnpm --filter redroid-web-manager-web build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && pnpm --filter redroid-web-manager-web typecheck"
  },
  "dependencies": {
    "dockerode": "^5.0.1",
    "effect": "^3.22.2",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.20.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
